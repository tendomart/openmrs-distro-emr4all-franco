{
  "@openmrs/esm-patient-chart-app": {
    "restrictByVisitLocationTag": true,
    "showUpcomingAppointments": true,
    "extensionSlots": {
      "action-menu-patient-chart-items-slot": {
        "order": ["order-basket-action-menu"]
      }
    }
  },
  "@openmrs/esm-ward-app": {
    "extensionSlots": {
      "action-menu-ward-patient-items-slot": {
        "add": ["order-basket-action-menu"]
      }
    }
  },
  "gender": [
        {
          "value": "male",
          "label": "Male"
        },
        {
          "value": "female",
          "label": "Female"
        }
      ],
      "phone": {
        "validation": {
          "required": false
        }
      }
  ,
  "@openmrs/esm-styleguide": {
    "Brand color #1": "#005d5d",
    "Brand color #2": "#611502",
    "Brand color #3": "#f23c0f",
    "implementationName": "MaliEMR"
  },
  "@openmrs/esm-login-app": {
    "logo": {
      "src": "/openmrs/spa/maliemr-logo.png",
      "alt": "MaliEMR"
    }
  },
  "footer": {
      "additionalLogos": [
        {
          "src": "/openmrs/spa/maliemr-logo.png",
          "alt": "MaliEMR",
          "link": "https://maliemr.org" 
        } 
      ]
    }
}
