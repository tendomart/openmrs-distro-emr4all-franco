                "conceptMappings": [{ "type": "CIEL", "value": "160108" }],
                "answers": [
                  {
                    "concept": "116128AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                    "label": "Uncomplicated Malaria (Paludisme Simple)",
                    "conceptMappings": [{ "type": "CIEL", "value": "116128" }]
                  },
                  {
                    "concept": "116126AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                    "label": "Severe Malaria (Paludisme Grave)",
                    "conceptMappings": [{ "type": "CIEL", "value": "116126" }]
                  }
                ]
              },
              "hide": {
                "hideWhenExpression": "testResult !== '703AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA'"
              }
            }
          ]
        },
        {
          "label": "Treatment / Traitement (ACT Protocol)",
          "isExpanded": "true",
          "questions": [
            {
              "label": "Antimalarial Drug Prescribed / Antipaludique Prescrit",
              "type": "obs",
              "id": "antimalarialDrug",
              "required": false,
              "questionInfo": "IV Artesunate option is only shown for Severe Malaria classification. Cannot be prescribed if Lab Result is Negative.",
              "questionOptions": {
                "rendering": "select",
                "concept": "1282AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                "conceptMappings": [{ "type": "CIEL", "value": "1282" }],
                "answers": [
                  {
                    "concept": "161350AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                    "label": "AL — Artemether-Lumefantrine",
                    "conceptMappings": [{ "type": "CIEL", "value": "161350" }]
                  },
                  {
                    "concept": "160515AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                    "label": "ASAQ — Artesunate-Amodiaquine",
                    "conceptMappings": [{ "type": "CIEL", "value": "160515" }]
                  },
                  {
                    "concept": "71100AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                    "label": "IV Artesunate (Severe Malaria Only / Paludisme Grave uniquement)",
                    "conceptMappings": [{ "type": "CIEL", "value": "71100" }]
                  }
                ]
              },
              "hide": {
                "hideWhenExpression": "testResult !== '703AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA'"
              },
              "validators": [
                {
                  "type": "js_expression",
                  "failsWhenExpression": "!isEmpty(antimalarialDrug) && testResult === '664AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA'",
                  "message": "Antimalarial drug cannot be prescribed when the laboratory result is Negative. / Un antipaludique ne peut pas être prescrit si le résultat de laboratoire est Négatif."
                },
                {
                  "type": "js_expression",
                  "failsWhenExpression": "antimalarialDrug === '71100AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA' && classification !== '116126AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA'",
                  "message": "IV Artesunate is reserved for Severe Malaria only. / L'Artésunate IV est réservé au Paludisme Grave uniquement."
                }
              ]
            },
            {
              "label": "LLIN Bednet Usage / Utilisation de MILDA (Moustiquaire Imprégnée d'Insecticide Longue Durée d'Action)",
              "type": "obs",
