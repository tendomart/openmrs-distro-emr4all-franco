      "label": "Page 1: Clinical Assessment (Signes de Danger)",
      "sections": [
        {
          "label": "Patient Vitals / Signes Vitaux",
          "isExpanded": "true",
          "questions": [
            {
              "label": "Weight (kg) / Poids (kg)",
              "type": "obs",
              "id": "weight",
              "required": true,
              "questionOptions": {
                "rendering": "number",
                "concept": "5089AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                "min": "0.5",
                "max": "200",
                "conceptMappings": [{ "type": "CIEL", "value": "5089" }]
              },
              "validators": [
                {
                  "type": "range",
                  "min": "0.5",
                  "max": "200",
                  "allowDecimals": true
                }
              ]
            },
            {
              "label": "Temperature (°C) / Température (°C)",
              "type": "obs",
              "id": "temperature",
              "required": false,
              "questionOptions": {
                "rendering": "number",
                "concept": "5088AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                "min": "34",
                "max": "43",
                "conceptMappings": [{ "type": "CIEL", "value": "5088" }]
              },
              "validators": [
                {
                  "type": "range",
                  "min": "34",
                  "max": "43",
                  "allowDecimals": true
                }
              ]
            }
          ]
        },
        {
          "label": "Danger Signs / Signes de Danger",
          "isExpanded": "true",
          "questions": [
            {
              "label": "Danger Signs / Signes de Danger",
              "type": "obs",
              "id": "dangerSigns",
              "required": false,
              "questionInfo": "Select all danger signs present. Any selection will trigger a SEVERE MALARIA alert and recommend immediate stabilization.",
              "questionOptions": {
                "rendering": "checkbox",
                "concept": "162568AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                "conceptMappings": [{ "type": "CIEL", "value": "162568" }],
                "answers": [
                  {
                    "concept": "113054AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                    "label": "Convulsions / Convulsions",
                    "conceptMappings": [{ "type": "CIEL", "value": "113054" }]
                  },
                  {
                    "concept": "143050AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                    "label": "Lethargy / Unconsciousness (Léthargie / Inconscience)",
                    "conceptMappings": [{ "type": "CIEL", "value": "143050" }]
                  },
                  {
                    "concept": "152761AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                    "label": "Unable to Drink or Breastfeed (Incapacité de boire/téter)",
                    "conceptMappings": [{ "type": "CIEL", "value": "152761" }]
                  },
                  {
                    "concept": "122496AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                    "label": "Respiratory Distress (Détresse respiratoire)",
                    "conceptMappings": [{ "type": "CIEL", "value": "122496" }]
                  },
                  {
                    "concept": "135595AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                    "label": "Persistent Vomiting (Vomissements persistants)",
                    "conceptMappings": [{ "type": "CIEL", "value": "135595" }]
                  }
                ]
              }
            },

            {
              "type": "markdown",
              "id": "severeMalariaAlertNote",
              "value": "### ⚠️ ALERTE PALUDISME GRAVE / SEVERE MALARIA ALERT\n**Stabilisation et référence immédiates requises.**  \n**Immediate stabilization and referral required.**",
              "hide": {
                "hideWhenExpression": "isEmpty(dangerSigns)"
              }
            }

          ]
        }
      ]
    },
    {
      "label": "Page 2: Laboratory Diagnosis (Confirmation Biologique)",
      "sections": [
        {
          "label": "Diagnostic Test / Test Diagnostique",
          "isExpanded": "true",
          "questions": [
            {
              "label": "Test Performed / Test Effectué",
              "type": "obs",
              "id": "testPerformed",
              "required": true,
              "questionOptions": {
                "rendering": "radio",
                "concept": "1643AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                "conceptMappings": [{ "type": "CIEL", "value": "1643" }],
                "answers": [
                  {
                    "concept": "1643AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                    "label": "RDT — Rapid Diagnostic Test (Test de Diagnostic Rapide)",
                    "conceptMappings": [{ "type": "CIEL", "value": "1643" }]
                  },
                  {
                    "concept": "32AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                    "label": "Microscopy / Blood Smear (Frottis / Goutte Épaisse)",
                    "conceptMappings": [{ "type": "CIEL", "value": "32" }]
                  }
                ]
              }
            },
            {
              "label": "Test Result / Résultat du Test",
              "type": "obs",
              "id": "testResult",
              "required": true,
              "questionOptions": {
                "rendering": "radio",
                "concept": "1138AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                "conceptMappings": [{ "type": "CIEL", "value": "1138" }],
                "answers": [
                  {
                    "concept": "703AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                    "label": "Positive",
                    "conceptMappings": [{ "type": "CIEL", "value": "703" }]
                  },
                  {
                    "concept": "664AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                    "label": "Negative",
                    "conceptMappings": [{ "type": "CIEL", "value": "664" }]
                  }
                ]
              }
            },
            {
              "label": "Parasite Density / Densité Parasitaire (parasites/µL)",
              "type": "obs",
              "id": "parasiteDensity",
              "required": false,
              "questionInfo": "Only applicable when Microscopy / Blood Smear is selected.",
              "questionOptions": {
                "rendering": "number",
                "concept": "887AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                "conceptMappings": [{ "type": "CIEL", "value": "887" }],
                "min": "0"
              },
              "hide": {
                "hideWhenExpression": "testPerformed !== '32AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA'"
              }
            },
            {
              "label": "Plasmodium Species / Espèce de Plasmodium",
              "type": "obs",
              "id": "plasmodiumSpecies",
              "required": false,
              "questionOptions": {
                "rendering": "select",
                "concept": "160101AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                "conceptMappings": [{ "type": "CIEL", "value": "160101" }],
                "answers": [
                  {
                    "concept": "116125AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                    "label": "P. falciparum",
                    "conceptMappings": [{ "type": "CIEL", "value": "116125" }]
                  },
                  {
                    "concept": "116124AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                    "label": "P. vivax",
                    "conceptMappings": [{ "type": "CIEL", "value": "116124" }]
                  }
                ]
              },
              "hide": {
                "hideWhenExpression": "testResult !== '703AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA'"
              }
            }
          ]
        }
      ]
    },
    {
      "label": "Page 3: Management & Disposition (Traitement & Issue)",
      "sections": [
